{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Voice Dictation",
  "version": "0.1.0",
  "identifier": "com.stt",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Voice Dictation Widget",
        "width": 400,
        "height": 60,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "alwaysOnTop": true,
        "decorations": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "macOS": {
      "notarization": {
        "appleId": "${APPLE_ID}",
        "appleIdPassword": "${APPLE_PASSWORD}",
        "teamId": "${APPLE_TEAM_ID}"
      }
    }
  },
  "updater": {
    "active": true,
    "endpoints": [
      "https://github.com/your-username/your-repo/releases/latest/download/latest.json"
    ],
    "dialog": true,
    "pubkey": "your-public-key-here"
  },
  "plugins": {
    "autostart": {
      "frontend": true
    }
  }
}
